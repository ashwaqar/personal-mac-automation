rules:

  dmg:
    archive_after_days: 3
    trash_after_days: 14

  pkg:
    archive_after_days: 3
    trash_after_days: 14

  zip:
    archive_after_days: 7
    trash_after_days: 30

  pdf:
    archive_after_days: 30
    trash_after_days: 90

  docx:
    archive_after_days: 30
    trash_after_days: 90

  xlsx:
    archive_after_days: 30
    trash_after_days: 90

default:
  archive_after_days: 14
  trash_after_days: 60
